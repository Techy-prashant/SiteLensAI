<svg viewBox="0 0 220 200" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="sitelens-gold" x1="20" y1="20" x2="160" y2="160" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FBBF24" />
      <stop offset="100%" stop-color="#D97706" />
    </linearGradient>

    <linearGradient id="sitelens-lens-bg" x1="75" y1="40" x2="155" y2="130" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#FCD34D" />
      <stop offset="60%" stop-color="#F59E0B" />
      <stop offset="100%" stop-color="#D97706" />
    </linearGradient>

    <clipPath id="lens-clip">
      <circle cx="118" cy="84" r="42" />
    </clipPath>
  </defs>

  <!-- AI / CIRCUIT TRACES (Left Side) -->
  <g stroke="url(#sitelens-gold)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none">
    <path d="M 76 50 L 52 50 L 40 36 L 32 36" />
    <circle cx="30" cy="36" r="3.5" stroke="#F59E0B" stroke-width="2.5" fill="#18181B" />

    <path d="M 72 68 L 46 68 L 36 56 L 24 56" />
    <circle cx="22" cy="56" r="3.5" stroke="#F59E0B" stroke-width="2.5" fill="#18181B" />

    <path d="M 70 85 L 42 85 L 30 96 L 16 96" />
    <circle cx="14" cy="96" r="3.5" stroke="#F59E0B" stroke-width="2.5" fill="#18181B" />

    <path d="M 74 104 L 50 104 L 40 118 L 28 118" />
    <circle cx="26" cy="118" r="3.5" stroke="#F59E0B" stroke-width="2.5" fill="#18181B" />

    <path d="M 80 120 L 58 120 L 50 134 L 42 134" />
    <circle cx="40" cy="134" r="3.5" stroke="#F59E0B" stroke-width="2.5" fill="#18181B" />
  </g>

  <!-- LENS BACKGROUND & SCENERY -->
  <circle cx="118" cy="84" r="42" fill="url(#sitelens-lens-bg)" />

  <g clip-path="url(#lens-clip)">
    <!-- Skyline -->
    <rect x="80" y="90" width="12" height="36" fill="#D97706" opacity="0.4" />
    <rect x="94" y="80" width="16" height="46" fill="#B45309" opacity="0.5" />
    <rect x="135" y="86" width="14" height="40" fill="#D97706" opacity="0.4" />

    <!-- Scaffolding Grid -->
    <g stroke="#FFFFFF" stroke-width="1.2" opacity="0.9">
      <line x1="88" y1="70" x2="88" y2="126" />
      <line x1="98" y1="65" x2="98" y2="126" />
      <line x1="108" y1="60" x2="108" y2="126" />
      <line x1="118" y1="62" x2="118" y2="126" />
      <line x1="128" y1="68" x2="128" y2="126" />

      <line x1="85" y1="72" x2="130" y2="72" />
      <line x1="85" y1="82" x2="132" y2="82" />
      <line x1="85" y1="92" x2="132" y2="92" />
      <line x1="85" y1="102" x2="132" y2="102" />
      <line x1="85" y1="112" x2="132" y2="112" />

      <line x1="88" y1="72" x2="98" y2="82" />
      <line x1="98" y1="82" x2="108" y2="72" />
      <line x1="108" y1="72" x2="118" y2="82" />
      <line x1="98" y1="92" x2="108" y2="102" />
      <line x1="108" y1="102" x2="118" y2="92" />
      <line x1="118" y1="92" x2="128" y2="102" />
    </g>

    <!-- Tower Crane -->
    <g stroke="#374151" stroke-width="1.8" stroke-linecap="round">
      <line x1="134" y1="46" x2="134" y2="120" stroke="#4B5563" stroke-width="2" />
      <line x1="138" y1="46" x2="138" y2="120" stroke="#4B5563" stroke-width="2" />

      <line x1="134" y1="52" x2="138" y2="58" stroke="#4B5563" stroke-width="1" />
      <line x1="134" y1="64" x2="138" y2="70" stroke="#4B5563" stroke-width="1" />
      <line x1="134" y1="76" x2="138" y2="82" stroke="#4B5563" stroke-width="1" />
      <line x1="134" y1="88" x2="138" y2="94" stroke="#4B5563" stroke-width="1" />

      <polygon points="136,36 133,46 139,46" fill="#374151" />

      <line x1="92" y1="48" x2="152" y2="48" stroke="#374151" stroke-width="2" />
      <line x1="92" y1="52" x2="152" y2="52" stroke="#374151" stroke-width="1.2" />

      <line x1="136" y1="36" x2="95" y2="48" stroke="#4B5563" stroke-width="0.9" />
      <line x1="136" y1="36" x2="150" y2="48" stroke="#4B5563" stroke-width="0.9" />

      <rect x="110" y="52" width="4" height="2.5" fill="#1F2937" />
      <line x1="112" y1="54" x2="112" y2="78" stroke="#1F2937" stroke-width="1" />
      <circle cx="112" cy="80" r="1.8" fill="#1F2937" />
    </g>
  </g>

  <!-- MAGNIFYING GLASS FRAME & HANDLE -->
  <path d="M 118 36 A 48 48 0 0 1 152 118" stroke="#4B5563" stroke-width="11" stroke-linecap="round" fill="none" />
  <path d="M 152 118 A 48 48 0 0 1 118 36" stroke="#F59E0B" stroke-width="11" stroke-linecap="round" fill="none" />
  <path d="M 152 118 L 195 161" stroke="#4B5563" stroke-width="18" stroke-linecap="round" />
  <path d="M 152 118 L 195 161" stroke="#6B7280" stroke-width="10" stroke-linecap="round" />
</svg>
